@page "{id:guid}"
@using pmsa.Domain
@model pmsa.Pages.Admin.People.EditModel
@{
    ViewData["Title"] = Model.Person.FullName;
}

<h1 class="h3">@Model.Person.FullName</h1>
<p class="text-muted">@Model.Person.Email — @(Model.Person.IsActive ? "active" : "deactivated")</p>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div class="col-lg-6">
    <h2 class="h5 mt-4">Role</h2>
    <form method="post" asp-page-handler="Role" asp-route-id="@Model.Person.Id">
        <div class="mb-3">
            <label asp-for="Role" class="form-label">Role</label>
            <select asp-for="Role" class="form-select" asp-items="Html.GetEnumSelectList<Role>()"></select>
            <div class="form-text">Takes effect on their next request — they do not need to sign in again.</div>
        </div>
        <button type="submit" class="btn btn-primary">Change role</button>
    </form>

    <h2 class="h5 mt-5">Set a password</h2>
    <form method="post" asp-page-handler="ResetPassword" asp-route-id="@Model.Person.Id">
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            <div class="form-text">
                At least @PasswordPolicy.MinimumLength characters. There is no way to read their
                existing password — setting a new one is the only option.
            </div>
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-outline-secondary">Set password</button>
    </form>

    <p class="mt-5">
        <a asp-page="Index" class="btn btn-link px-0">Back to people</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
