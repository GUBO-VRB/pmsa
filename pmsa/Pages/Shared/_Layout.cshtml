@using pmsa.Security
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - pmsa</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/pmsa.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">pmsa</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @*
                        FR-009: every item a role does not permit is absent, not disabled. This is
                        a usability measure only — the refusal that actually protects anything is
                        FR-010, enforced on the route (see AuthorizeFolder in Program.cs).
                    *@
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">My hours</a>
                        </li>
                        @* Spec 012, FR-001: the report is offered to every signed-in person. The
                           role decides what the figures cover, not whether the screen exists. *@
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Reports/Projects">Reports</a>
                        </li>
                        @if (User.IsAdmin())
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Admin/People/Index">People</a>
                            </li>
                        }
                    </ul>

                    @if (User.Identity?.IsAuthenticated is true)
                    {
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Account/ChangePassword">
                                    @User.GetFullName()
                                </a>
                            </li>
                            <li class="nav-item">
                                @* A POST, so that no link or prefetch can sign anyone out. *@
                                <form method="post" asp-page="/Account/SignOut" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-link text-dark">Sign out</button>
                                </form>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - pmsa - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
